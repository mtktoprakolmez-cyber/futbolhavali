:[{"type":"edited","filename":"pxt.json","patch":[{"start1":224,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"},{"type":"added","filename":"main.blocks","value":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>"}]}],"snapshots":[{"timestamp":1791985599883,"editorVersion":"4.1.25","text":{"main.ts":"// 1. Özel Sprite Türünün Tanımlanması\r\nnamespace SpriteKind {\r\n    export const Obstacle = SpriteKind.create()\r\n    export const SkorTabelasi = SpriteKind.create()\r\n}\r\n\r\n// Skor Değişkenleri\r\nlet skorGS = 0\r\nlet skorFB = 0\r\n\r\n// Oyun Alanı\r\nscene.setBackgroundColor(7) // Yeşil saha\r\n\r\n// 2. Eklentisiz Skor Tabelası Çözümü (Görüntü tabanlı dinamik metin oluşturma)\r\nlet skorTablosu = sprites.create(image.create(80, 15), SpriteKind.SkorTabelasi)\r\nskorTablosu.setPosition(80, 12)\r\n\r\nfunction skoruGuncelle() {\r\n    // Skor görüntüsünü temizle ve yeni skor metnini üzerine çiz\r\n    skorTablosu.image.fill(0) // Şeffaf arka plan\r\n    skorTablosu.image.print(\"GS: \" + skorGS + \" - \" + skorFB + \" :FB\", 2, 2, 1) // Beyaz renkli yazı\r\n}\r\n\r\n// Sol Kale (Fenerbahçe'nin koruduğu kale)\r\nlet solKale = sprites.create(img`\r\n    . . . . .\r\n    . f f f .\r\n    . f . f .\r\n    . f . f .\r\n    . f . f .\r\n    . f . f .\r\n    . f . f .\r\n    . f f f .\r\n    . . . . .\r\n`, SpriteKind.Obstacle)\r\nsolKale.setPosition(10, 60)\r\n\r\n// Sağ Kale (Galatasaray'ın koruduğu kale)\r\nlet sagKale = sprites.create(img`\r\n    . . . . .\r\n    . f f f .\r\n    . f . f .\r\n    . f . f .\r\n    . f . f .\r\n    . f . f .\r\n    . f . f .\r\n    . f f f .\r\n    . . . . .\r\n`, SpriteKind.Obstacle)\r\nsagKale.setPosition(150, 60)\r\n\r\n// Oyuncu 1: Galatasaray (Kırmızı Forma)\r\nlet oyuncuGS = sprites.create(img`\r\n    . . . . . . f f f f . . . . . . \r\n    . . . . f f e e e e f f . . . . \r\n    . . . f e e e f f e e e f . . . \r\n    . . f e e f f d d f f e e f . . \r\n    . . f e f d d d d d d f e f . . \r\n    . . f d d d d d d d d d d f . . \r\n    . . f d d f d d d d f d d f . . \r\n    . . f d d f d d d d f d d f . . \r\n    . . . f d d d d d d d d f . . . \r\n    . . . . f f f f f f f f . . . . \r\n    . . . . f 2 2 2 2 2 2 f . . . . \r\n    . . . f 2 2 2 2 2 2 2 2 f . . . \r\n    . . . f 2 2 5 5 5 5 2 2 f . . . \r\n    . . . f 2 2 5 5 5 5 2 2 f . . . \r\n    . . . . f f f f f f f f . . . . \r\n    . . . . . f f . . f f . . . . . \r\n`, SpriteKind.Player)\r\noyuncuGS.setPosition(40, 60)\r\noyuncuGS.setStayInScreen(true)\r\ncontroller.moveSprite(oyuncuGS, 70, 70)\r\n\r\n// Oyuncu 2: Fenerbahçe (Lacivert Forma)\r\nlet oyuncuFB = sprites.create(img`\r\n    . . . . . . f f f f . . . . . . \r\n    . . . . f f e e e e f f . . . . \r\n    . . . f e e e f f e e e f . . . \r\n    . . f e e f f d d f f e e f . . \r\n    . . f e f d d d d d d f e f . . \r\n    . . f d d d d d d d d d d f . . \r\n    . . f d d f d d d d f d d f . . \r\n    . . f d d f d d d d f d d f . . \r\n    . . . f d d d d d d d d f . . . \r\n    . . . . f f f f f f f f . . . . \r\n    . . . . f 8 8 8 8 8 8 f . . . . \r\n    . . . f 8 8 8 8 8 8 8 8 f . . . \r\n    . . . f 8 8 5 5 5 5 8 8 f . . . \r\n    . . . f 8 8 5 5 5 5 8 8 f . . . \r\n    . . . . f f f f f f f f . . . . \r\n    . . . . . f f . . f f . . . . . \r\n`, SpriteKind.Player)\r\noyuncuFB.setPosition(120, 60)\r\noyuncuFB.setStayInScreen(true)\r\ncontroller.player2.moveSprite(oyuncuFB, 70, 70)\r\n\r\n// Topun Oluşturulması\r\nlet top = sprites.create(img`\r\n    . . . . . . . . . . . . . . . . \r\n    . . . . . . f f f f . . . . . . \r\n    . . . . f f 1 1 1 1 f f . . . . \r\n    . . . f 1 1 f f f f 1 1 f . . . \r\n    . . f 1 1 f 1 1 1 1 f 1 1 f . . \r\n    . . f 1 f 1 1 f f 1 1 f 1 f . . \r\n    . f 1 1 f 1 f 1 1 f 1 f 1 1 f . \r\n    . f 1 1 f 1 f 1 1 f 1 f 1 1 f . \r\n    . f 1 1 f 1 f 1 1 f 1 f 1 1 f . \r\n    . f 1 1 f 1 f 1 1 f 1 f 1 1 f . \r\n    . . f 1 f 1 1 f f 1 1 f 1 f . . \r\n    . . f 1 1 f 1 1 1 1 f 1 1 f . . \r\n    . . . f 1 1 f f f f 1 1 f . . . \r\n    . . . . f f 1 1 1 1 f f . . . . \r\n    . . . . . . f f f f . . . . . . \r\n    . . . . . . . . . . . . . . . . \r\n`, SpriteKind.Projectile)\r\ntop.setPosition(80, 60)\r\ntop.setStayInScreen(true)\r\ntop.vx = 0\r\ntop.vy = 0\r\n\r\n// Topa Fizik Ekleme\r\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Projectile, function (sprite, otherSprite) {\r\n    otherSprite.vx = (otherSprite.x - sprite.x) * 5\r\n    otherSprite.vy = (otherSprite.y - sprite.y) * 5\r\n})\r\n\r\n// Sürtünme Simülasyonu (Top yavaş yavaş durur)\r\ngame.onUpdate(function () {\r\n    top.vx = top.vx * 0.95\r\n    top.vy = top.vy * 0.95\r\n})\r\n\r\n// Gol Kontrolleri\r\nsprites.onOverlap(SpriteKind.Projectile, SpriteKind.Obstacle, function (sprite, otherSprite) {\r\n    if (otherSprite == sagKale) {\r\n        skorGS += 1\r\n        music.play(music.melodyPlayable(music.baDing), music.PlaybackMode.UntilDone)\r\n        game.splash(\"GALATASARAY GOL ATTI!\")\r\n        yenidenBaslat()\r\n    } else if (otherSprite == solKale) {\r\n        skorFB += 1\r\n        music.play(music.melodyPlayable(music.baDing), music.PlaybackMode.UntilDone)\r\n        game.splash(\"FENERBAHÇE GOL ATTI!\")\r\n        yenidenBaslat()\r\n    }\r\n})\r\n\r\n// Pozisyonları Sıfırlama ve Kazanma Kontrolü\r\nfunction yenidenBaslat() {\r\n    top.setPosition(80, 60)\r\n    top.vx = 0\r\n    top.vy = 0\r\n    oyuncuGS.setPosition(40, 60)\r\n    oyuncuFB.setPosition(120, 60)\r\n    skoruGuncelle()\r\n\r\n    if (skorGS >= 5) {\r\n        game.setGameOverMessage(true, \"Şampiyon Galatasaray!\")\r\n        game.gameOver(true)\r\n    } else if (skorFB >= 5) {\r\n        game.setGameOverMessage(true, \"Şampiyon Fenerbahçe!\")\r\n        game.gameOver(true)\r\n    }\r\n}\r\n\r\n// İlk açılışta skoru yazdır\r\nskoruGuncelle()\r\n","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"Futbolhavali\",\n    \"description\": \"futbol\\n\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"multiplayer\": \"*\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"stable4.1\",\n        \"tag\": \"v4.1.25\",\n        \"commits\": \"https://github.com/microsoft/pxt-arcade/commits/d4885bd35de1a9300183bf5a3fd1eec816992625\",\n        \"target\": \"4.1.25\",\n        \"pxt\": \"13.1.23\"\n    },\n    \"preferredEditor\": \"tsprj\",\n    \"languageRestriction\": \"javascript-only\"\n}\n"}},{"timestamp":1791997477436,"editorVersion":"4.1.25","text":{"main.ts":"// Özel Türlerin Tanımlanması\r\nnamespace SpriteKind {\r\n    export const Obstacle = SpriteKind.create()\r\n    export const SkorTabelasi = SpriteKind.create()\r\n    export const MenuElemani = SpriteKind.create()\r\n}\r\n\r\n// Takım Yapısı ve 10 Takımlı Liste\r\ninterface Takim {\r\n    isim: string;\r\n    renk: number;\r\n}\r\n\r\nlet takimlar: Takim[] = [\r\n    { isim: \"Galatasaray\", renk: 2 },\r\n    { isim: \"Fenerbahce\", renk: 8 },\r\n    { isim: \"Besiktas\", renk: 15 },\r\n    { isim: \"Trabzonspor\", renk: 11 },\r\n    { isim: \"Barcelona\", renk: 4 },\r\n    { isim: \"Real Madrid\", renk: 1 },\r\n    { isim: \"Man City\", renk: 9 },\r\n    { isim: \"Bayern Munih\", renk: 10 },\r\n    { isim: \"PSG\", renk: 13 },\r\n    { isim: \"Liverpool\", renk: 5 }\r\n]\r\n\r\nlet secilenTakim1: Takim = takimlar[0]\r\nlet secilenTakim2: Takim = takimlar[1]\r\nlet skor1 = 0\r\nlet skor2 = 0\r\n\r\n// Görsel Menü Değişkenleri\r\nlet suAnkiSecimIdx = 0\r\nlet hangiOyuncuSeciyor = 1\r\nlet menuYazisi: Sprite = null\r\n\r\n// Oyun Nesneleri\r\nlet solKale: Sprite = null\r\nlet sagKale: Sprite = null\r\nlet skorTablosu: Sprite = null\r\nlet oyuncu1: Sprite = null\r\nlet oyuncu2: Sprite = null\r\nlet top: Sprite = null\r\nlet oyunBasladi = false\r\n\r\n// GÖRSEL TAKIM SEÇİM EKRANI FONKSİYONU\r\nfunction menuGoster() {\r\n    scene.setBackgroundColor(11) // Menü için mavi arka plan\r\n\r\n    menuYazisi = sprites.create(image.create(160, 40), SpriteKind.MenuElemani)\r\n    menuYazisi.setPosition(80, 60)\r\n    menuGuncelle()\r\n}\r\n\r\nfunction menuGuncelle() {\r\n    menuYazisi.image.fill(0)\r\n    let baslik = \"OYUNCU \" + hangiOyuncuSeciyor + \" TAKIM SECIN\"\r\n    let takimIsim = \"< \" + takimlar[suAnkiSecimIdx].isim + \" >\"\r\n\r\n    // Menü metinlerini standart font (image.font5) ve beyaz renk (1) ile çiz\r\n    menuYazisi.image.printCenter(baslik, 5, 1, image.font5)\r\n    menuYazisi.image.printCenter(takimIsim, 20, 5, image.font5)\r\n    menuYazisi.image.printCenter(\"[A]: Degistir [B]: Onayla\", 32, 9, image.font5)\r\n}\r\n\r\n// Buton Kontrolleri (Menü ve Oyun İçin)\r\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (!oyunBasladi) {\r\n        // Sonraki takıma geç\r\n        suAnkiSecimIdx = (suAnkiSecimIdx + 1) % takimlar.length\r\n        music.play(music.melodyPlayable(music.pewPew), music.PlaybackMode.InBackground)\r\n        menuGuncelle()\r\n    }\r\n})\r\n\r\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (!oyunBasladi) {\r\n        music.play(music.melodyPlayable(music.baDing), music.PlaybackMode.InBackground)\r\n        if (hangiOyuncuSeciyor == 1) {\r\n            secilenTakim1 = takimlar[suAnkiSecimIdx]\r\n            hangiOyuncuSeciyor = 2\r\n            suAnkiSecimIdx = (suAnkiSecimIdx + 1) % takimlar.length // 2. oyuncu farklı başlasın\r\n            menuGuncelle()\r\n        } else {\r\n            secilenTakim2 = takimlar[suAnkiSecimIdx]\r\n            // İki oyuncu da seçti, menüyü temizle ve oyunu başlat\r\n            menuYazisi.destroy()\r\n            anaOyunuBaslat()\r\n        }\r\n    }\r\n})\r\n\r\n// ANA OYUN KURULUMU\r\nfunction anaOyunuBaslat() {\r\n    oyunBasladi = true\r\n    scene.setBackgroundColor(7) // Yeşil saha\r\n\r\n    // Büyütülmüş Kaleler\r\n    solKale = sprites.create(img`\r\n        . f f f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f f f .\r\n    `, SpriteKind.Obstacle)\r\n    solKale.setPosition(8, 60)\r\n\r\n    sagKale = sprites.create(img`\r\n        . f f f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f . f .\r\n        . f f f .\r\n    `, SpriteKind.Obstacle)\r\n    sagKale.setPosition(152, 60)\r\n\r\n    // Oyuncular\r\n    oyuncu1 = sprites.create(img`\r\n        . . . . . . f f f f . . . . . . \r\n        . . . . f f e e e e f f . . . . \r\n        . . . f e e e f f e e e f . . . \r\n        . . f e e f f d d f f e e f . . \r\n        . . f e f d d d d d d f e f . . \r\n        . . f d d d d d d d d d d f . . \r\n        . . f d d f d d d d f d d f . . \r\n        . . f d d f d d d d f d d f . . \r\n        . . . f d d d d d d d d f . . . \r\n        . . . . f f f f f f f f . . . . \r\n        . . . . f 5 5 5 5 5 5 f . . . . \r\n        . . . f 5 5 5 5 5 5 5 5 f . . . \r\n        . . . f 5 5 5 5 5 5 5 5 f . . . \r\n        . . . f 5 5 5 5 5 5 5 5 f . . . \r\n        . . . . f f f f f f f f . . . . \r\n        . . . . . f f . . f f . . . . . \r\n    `, SpriteKind.Player)\r\n\r\n    oyuncu2 = sprites.create(img`\r\n        . . . . . . f f f f . . . . . . \r\n        . . . . f f e e e e f f . . . . \r\n        . . . f e e e f f e e e f . . . \r\n        . . f e e f f d d f f e e f . . \r\n        . . f e f d d d d d d f e f . . \r\n        . . f d d d d d d d d d d f . . \r\n        . . f d d f d d d d f d d f . . \r\n        . . f d d f d d d d f d d f . . \r\n        . . . f d d d d d d d d f . . . \r\n        . . . . f f f f f f f f . . . . \r\n        . . . . f 5 5 5 5 5 5 f . . . . \r\n        . . . f 5 5 5 5 5 5 5 5 f . . . \r\n        . . . f 5 5 5 5 5 5 5 5 f . . . \r\n        . . . f 5 5 5 5 5 5 5 5 f . . . \r\n        . . . . f f f f f f f f . . . . \r\n        . . . . . f f . . f f . . . . . \r\n    `, SpriteKind.Player)\r\n\r\n    formaRenginiAyarla(oyuncu1, secilenTakim1.renk)\r\n    formaRenginiAyarla(oyuncu2, secilenTakim2.renk)\r\n\r\n    oyuncu1.setPosition(40, 60)\r\n    oyuncu1.setStayInScreen(true)\r\n    controller.moveSprite(oyuncu1, 75, 75)\r\n\r\n    oyuncu2.setPosition(120, 60)\r\n    oyuncu2.setStayInScreen(true)\r\n    controller.player2.moveSprite(oyuncu2, 75, 75)\r\n\r\n    // Top\r\n    top = sprites.create(img`\r\n        . . . . . . f f f f . . . . . . \r\n        . . . . f f 1 1 1 1 f f . . . . \r\n        . . . f 1 1 f f f f 1 1 f . . . \r\n        . . f 1 1 f 1 1 1 1 f 1 1 f . . \r\n        . . f 1 f 1 1 f f 1 1 f 1 f . . \r\n        . f 1 1 f 1 f 1 1 f 1 f 1 1 f . \r\n        . f 1 1 f 1 f 1 1 f 1 f 1 1 f . \r\n        . f 1 1 f 1 f 1 1 f 1 f 1 1 f . \r\n        . f 1 1 f 1 f 1 1 f 1 f 1 1 f . \r\n        . . f 1 f 1 1 f f 1 1 f 1 f . . \r\n        . . f 1 1 f 1 1 1 1 f 1 1 f . . \r\n        . . . f 1 1 f f f f 1 1 f . . . \r\n        . . . . f f 1 1 1 1 f f . . . . \r\n        . . . . . . f f f f . . . . . . \r\n    `, SpriteKind.Projectile)\r\n    top.setPosition(80, 60)\r\n    top.vx = 0\r\n    top.vy = 0\r\n\r\n    // Skor Tabelası\r\n    skorTablosu = sprites.create(image.create(140, 15), SpriteKind.SkorTabelasi)\r\n    skorTablosu.setPosition(80, 10)\r\n    skoruGuncelle()\r\n}\r\n\r\nfunction skoruGuncelle() {\r\n    skorTablosu.image.fill(0)\r\n    let metin = secilenTakim1.isim + \": \" + skor1 + \" - \" + skor2 + \" :\" + secilenTakim2.isim\r\n    skorTablosu.image.printCenter(metin, 2, 1, image.font5)\r\n}\r\n\r\n// Oyuncu ve Top Fizikleri\r\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Projectile, function (sprite, otherSprite) {\r\n    if (!oyunBasladi) return\r\n    otherSprite.vx = (otherSprite.x - sprite.x) * 6\r\n    otherSprite.vy = (otherSprite.y - sprite.y) * 6\r\n})\r\n\r\n// Sürtünme ve KÖŞELERDEN/DUVARLARDAN SEKMESİ\r\ngame.onUpdate(function () {\r\n    if (!oyunBasladi) return\r\n    top.vx = top.vx * 0.96\r\n    top.vy = top.vy * 0.96\r\n\r\n    if (top.x <= 4) { top.x = 4; top.vx = -top.vx * 0.8; }\r\n    if (top.x >= 156) { top.x = 156; top.vx = -top.vx * 0.8; }\r\n    if (top.y <= 4) { top.y = 4; top.vy = -top.vy * 0.8; }\r\n    if (top.y >= 116) { top.y = 116; top.vy = -top.vy * 0.8; }\r\n})\r\n\r\n// Gol Algılama\r\nsprites.onOverlap(SpriteKind.Projectile, SpriteKind.Obstacle, function (sprite, otherSprite) {\r\n    if (!oyunBasladi) return\r\n    if (otherSprite == sagKale) {\r\n        skor1 += 1\r\n        music.play(music.melodyPlayable(music.baDing), music.PlaybackMode.UntilDone)\r\n        game.splash(secilenTakim1.isim + \" GOL ATTI!\")\r\n        pozisyonlariSifirla()\r\n    } else if (otherSprite == solKale) {\r\n        skor2 += 1\r\n        music.play(music.melodyPlayable(music.baDing), music.PlaybackMode.UntilDone)\r\n        game.splash(secilenTakim2.isim + \" GOL ATTI!\")\r\n        pozisyonlariSifirla()\r\n    }\r\n})\r\n\r\nfunction pozisyonlariSifirla() {\r\n    top.setPosition(80, 60)\r\n    top.vx = 0\r\n    top.vy = 0\r\n    oyuncu1.setPosition(40, 60)\r\n    oyuncu2.setPosition(120, 60)\r\n    skoruGuncelle()\r\n\r\n    if (skor1 >= 5) {\r\n        game.setGameOverMessage(true, \"Sampiyon \" + secilenTakim1.isim + \"!\")\r\n        game.gameOver(true)\r\n    } else if (skor2 >= 5) {\r\n        game.setGameOverMessage(true, \"Sampiyon \" + secilenTakim2.isim + \"!\")\r\n        game.gameOver(true)\r\n    }\r\n}\r\n\r\nfunction formaRenginiAyarla(oyuncuSprite: Sprite, renkKodu: number) {\r\n    let img = oyuncuSprite.image\r\n    for (let x = 0; x < img.width; x++) {\r\n        for (let y = 0; y < img.height; y++) {\r\n            if (img.getPixel(x, y) == 5) {\r\n                img.setPixel(x, y, renkKodu)\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n// Oyunu Menüyle Başlat\r\nmenuGoster()\r\n","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"Futbolhavali\",\n    \"description\": \"futbol\\n\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"multiplayer\": \"*\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"stable4.1\",\n        \"tag\": \"v4.1.25\",\n        \"commits\": \"https://github.com/microsoft/pxt-arcade/commits/d4885bd35de1a9300183bf5a3fd1eec816992625\",\n        \"target\": \"4.1.25\",\n        \"pxt\": \"13.1.23\"\n    },\n    \"preferredEditor\": \"tsprj\",\n    \"languageRestriction\": \"javascript-only\"\n}\n"}}],"shares":[{"id":"34498-80126-91327-91575","type":"permalink","timestamp":1791985787991}],"lastSaveTime":1791997654390}